{
	"name": "pi-tui-footer",
	"version": "1.2.2",
	"description": "pi extension: TUI footer/header with git status, telemetry, rounded tools, editor and settings enhancements",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"tui"
	],
	"license": "MIT",
	"files": [
		"extensions",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/onenora/pi-tui-footer.git"
	},
	"pi": {
		"extensions": ["./extensions"]
	},
	"scripts": {
		"check": "bun -e 'import * as index from \"./extensions/index.ts\"; import * as tools from \"./extensions/rounded-tools.ts\"; console.log(\"All extension modules passed integrity check.\");'",
		"sync": "bun scripts/sync-upstream.ts",
		"sync:check": "bun scripts/sync-upstream.ts --check",
		"sync:apply": "bun scripts/sync-upstream.ts --apply"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"@types/node": "^22.0.0"
	}
}
