{
	"name": "pi-tui-footer",
	"version": "2.0.1",
	"description": "Header, status footer, rounded editor and background-free rounded tool frames for pi",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi-extension",
		"tui",
		"footer"
	],
	"license": "MIT",
	"files": [
		"extensions",
		"README.md",
		"LICENSE"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/onenora/pi-tui-footer.git"
	},
	"pi": {
		"extensions": ["./extensions"]
	},
	"scripts": {
		"check": "bun -e 'import ext from \"./extensions/index.ts\"; console.log(\"Extension loaded successfully.\");'",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"@types/node": "^22.0.0",
		"typescript": "^5.0.0"
	}
}
